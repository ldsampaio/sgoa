# SGOA v0.1 — exemplo de .env de PRODUÇÃO (servidor da universidade).
# Copiar para `.env` ao lado do docker-compose.prod.yml e preencher.
# NUNCA commitar o `.env` real (contém segredos).

# --- Banco Postgres (compose) ---
POSTGRES_DB=sgoa
POSTGRES_USER=sgoa
# Gerar com: openssl rand -hex 32
# ATENÇÃO: use só letras e números aqui — a senha também vai na DATABASE_URL
# montada pelo compose, onde caracteres como @, # ou : quebram a conexão
# (ou aplique URL-encoding: @=%40, #=%23, :=%3A, /=%2F).
POSTGRES_PASSWORD=TROCAR_senha_forte_aqui
# Tamanho máximo do pool de conexões Postgres da API.
PG_POOL_MAX=10

# --- Imagem (fixar pela tag do release, ex: ghcr.io/ldsampaio/sgoa:v0.1.1) ---
SGOA_IMAGE=ghcr.io/ldsampaio/sgoa:v0.1.1

# --- API ---
# Único uso de JWT_SECRET no sgoa: state anti-CSRF da integração Google
# (`src/services/googleCalendar.service.js`). O sgoa não assina token de sessão — o
# JWT-ponteiro é assinado pelo saga. Gerar com: openssl rand -hex 32. OBRIGATÓRIO trocar.
JWT_SECRET=TROCAR_segredo_jwt_forte_aqui
# Domínio público final (sem barra no fim). Usado no CORS e nos links.
CORS_ORIGIN=https://sgoa.sua-universidade.edu.br
FRONTEND_URL=https://sgoa.sua-universidade.edu.br
MAX_UPLOAD_SIZE=52428800

# --- Identidade e sessão (contrato compartilhado: ../../docs/session-contract.md) ---
# O sgoa não autentica credencial: ele confirma no Redis que a sessão do saga está viva.
# Sem Redis o verifier não pode confirmar liveness e o sgoa responde 503.
# Produção exige o usuário ACL `saga_readonly` — o sgoa nunca escreve no store de sessões.
REDIS_URL=redis://saga_readonly:TROCAR_senha_acl_forte_aqui@redis:6379/0
SAGA_JWKS_URL=https://saga.sua-universidade.edu.br/.well-known/jwks.json
SAGA_LOGIN_URL=https://saga.sua-universidade.edu.br/login
# Allowlist explícita de hosts que podem aparecer em `login_url`. Sem allowlist o
# middleware não monta redirect (open redirect). Host sem porta.
PORTAL_ALLOWED_REDIRECT_HOSTS=sgoa.sua-universidade.edu.br
# Retry-After da resposta 503 IDENTITY_UNAVAILABLE (segundos).
IDENTITY_RETRY_AFTER=30

# --- Domínios de e-mail institucional permitidos (validação de destinatários) ---
ALLOWED_EMAIL_DOMAINS=utfpr.edu.br

# --- Conta institucional única de envio (SMTP da universidade) ---
SMTP_HOST=smtp.utfpr.edu.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sgoa@utfpr.edu.br
SMTP_FROM=sgoa@utfpr.edu.br
# Senha cifrada: gerar localmente com `node criptografar-smtp.js "senha"`
# usando o MESMO SMTP_TOKEN_KEY abaixo, e colar aqui.
SMTP_PASS_ENC=
# 32 bytes em hex (gerar com: openssl rand -hex 32). Trocar invalida SMTP_PASS_ENC.
SMTP_TOKEN_KEY=TROCAR_32_bytes_em_hex_aqui

# --- Google Calendar/Meet (opcional; vazio = desabilitado) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback do Google: PRECISA ser idêntico ao registrado no console do Google.
# Usa o domínio público (nunca localhost). Se vazio, deriva de FRONTEND_URL.
GOOGLE_REDIRECT_URI=https://sgoa.sua-universidade.edu.br/api/integracoes/google/callback
GOOGLE_TOKEN_KEY=TROCAR_32_bytes_em_hex_aqui
# Domínio base do Workspace; subdomínios (professores.utfpr.edu.br) são aceitos.
GOOGLE_WORKSPACE_DOMAIN=utfpr.edu.br

# --- Kafka / avaliação IA (compose já sobe o Kafka) ---
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=sgoa-backend
KAFKA_TOPIC_PEDIDOS=sgoa.avaliacoes.pendentes
KAFKA_TOPIC_RESULTADOS=sgoa.avaliacoes.resultados
KAFKA_GROUP_ID=sgoa-avaliacoes
AGENT_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AGENTE_IA_TOKEN=TROCAR_token_forte_aqui
API_PUBLIC_URL=https://sgoa.sua-universidade.edu.br

# --- Avisos de prazo ---
LEMBRETES_INTERVALO_MS=21600000

# --- Admin inicial ---
# O sgoa não cria usuário nem credencial (T10): não há bootstrap de admin aqui.
# Logar uma vez pelo portal do saga — o login institucional cria a identidade em
# `auth.users` — e atribuir o papel em `sgoa.perfis`.

# --- Seed (emergencial; padrão: travado em produção) ---
# O seed APAGA todas as tabelas. Só definir em caso extremo, com backup feito.
# ALLOW_SEED=1
