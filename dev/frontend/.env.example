# URL base da API backend (usada para requisições fora do proxy do Vite)
VITE_API_URL=http://localhost:3000/api

# Only for the placeholder text and the safe anchor render of Overleaf links (RF.OV).
# The authority is OVERLEAF_HOSTS on the backend — the server decides what is accepted.
VITE_OVERLEAF_HOST=overleaf.utfpr.edu.br
# SGTU (onda 7 do plano ../SGTU.md): destino do link de ticket da interface.
# O link monta origem=sgoa e rota=path atual — o SGTU valida os dois.
VITE_SGTU_URL=http://localhost:5175
