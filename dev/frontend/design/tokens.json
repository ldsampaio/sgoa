{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "system": "SGOA — Light Clay (claymorphism institucional)",
    "typography": "Space Grotesk (display) + DM Sans (body)",
    "dials": {
      "variance": 4,
      "motion": 4,
      "density": 6
    },
    "notes": "Clay contido: border 2-3px ink, radius md/lg, double shadow. Bounce apenas em botões e KPIs. Contrastes verificados (AA): ink 16:1 no cream, ink-muted 5.8:1, CTA #C2410C 5.2:1 com branco, red-700 6.5:1 com branco."
  },
  "primitive": {
    "color": {
      "cream": { "$value": "#FFF8EE", "$type": "color" },
      "canvas": { "$value": "#F4F1FA", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "ink": { "$value": "#1B1B2F", "$type": "color" },
      "ink-muted": { "$value": "#5B6270", "$type": "color" },
      "divider": { "$value": "#CDC5B8", "$type": "color" },
      "indigo": {
        "50": { "$value": "#EEF2FF", "$type": "color" },
        "100": { "$value": "#C7D2FE", "$type": "color" },
        "500": { "$value": "#6366F1", "$type": "color" },
        "600": { "$value": "#4F46E5", "$type": "color" },
        "700": { "$value": "#4338CA", "$type": "color" }
