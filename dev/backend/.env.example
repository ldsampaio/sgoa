PORT=3000
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=dev_secret_sgoa_change_me

# Tempo de expiração do token
JWT_EXPIRES_IN=2d

# Caminho do arquivo de banco SQLite (desenvolvimento)
DB_PATH=./data/sgoa.sqlite

# --- Banco de dados (SQLite em dev / Postgres em produção) ---
# sqlite (padrão): usa DB_PATH acima, zero configuração.
# postgres: defina DB_DRIVER=postgres e DATABASE_URL (exemplo abaixo).
# O CI testa os dois drivers; o schema é criado automaticamente no boot.
DB_DRIVER=sqlite
# Postgres local (exige um servidor PG; produção usa o do compose):
# DB_DRIVER=postgres
# DATABASE_URL=postgres://sgoa:senha@localhost:5432/sgoa
# Tamanho máximo do pool Postgres (produção).
PG_POOL_MAX=10

# Diretório onde os arquivos enviados serão armazenados
UPLOAD_DIR=./uploads

# Limite máximo de upload em bytes (50MB)
MAX_UPLOAD_SIZE=52428800

# URL base da API (usada pelo frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# --- Frontend servido pela API (container único de produção) ---
# Em dev fica false (Vite na 5173). No container, SERVE_FRONTEND=true e o
# Express serve o build em FRONTEND_DIST (padrão: ./public na imagem).
SERVE_FRONTEND=false
# FRONTEND_DIST=./public

# --- Domínios de e-mail institucional permitidos no cadastro ---
# Lista separada por vírgula. Subdomínios são aceitos
# (ex: alunos.utfpr.edu.br passa se utfpr.edu.br estiver listado).
# Vazio/indefinido = validação desativada (útil em dev com seed @sgoa.dev).
# Produção: ALLOWED_EMAIL_DOMAINS=utfpr.edu.br
ALLOWED_EMAIL_DOMAINS=

# --- Integração Google Calendar / Meet (OAuth por professor) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integracoes/google/callback
# 32 bytes em hex (gerar com: openssl rand -hex 32). Usada para criptografar refresh_tokens.
GOOGLE_TOKEN_KEY=
# Domínio Workspace exigido no login Google (ex: instituicao.edu.br). Vazio = aceita qualquer conta.
GOOGLE_WORKSPACE_DOMAIN=
# URL do frontend (para redirecionar o callback OAuth)
FRONTEND_URL=http://localhost:5173

# --- Avaliação de trabalhos por IA via Kafka ---
# false = avaliações ficam "pendente" sem publicar (dev sem docker)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sgoa-backend
KAFKA_TOPIC_PEDIDOS=sgoa.avaliacoes.pendentes
KAFKA_TOPIC_RESULTADOS=sgoa.avaliacoes.resultados
KAFKA_GROUP_ID=sgoa-avaliacoes
# Token de serviço para o agente de IA baixar arquivos (header X-Agent-Token ou Bearer)
AGENTE_IA_TOKEN=
# URL pública da API usada no download_url enviado ao agente
API_PUBLIC_URL=http://localhost:3000

# --- Agente interno de avaliação (consumer + OpenRouter, só modelos :free) ---
# false = o agente não consome (permite usar um agente externo no mesmo tópico)
AGENT_ENABLED=true
OPENROUTER_API_KEY=
# Modelo free padrão (pode trocar por outro com sufixo :free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Limites do pipeline de 2 passes (map: resume chunks; reduce: parecer final)
OPENROUTER_CHUNK_CHARS=15000
OPENROUTER_MAX_CHUNKS=8
OPENROUTER_MAX_TOKENS_RESUMO=1200
OPENROUTER_MAX_TOKENS_PARECER=2500
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_RETRIES=5
# Override da URL base (só para testes com stub local; produção: omitir)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Mínimo de caracteres extraídos para aceitar o texto (PDF digitalizado falha abaixo disso)
AGENT_MIN_CHARS=500
# Headers recomendados pela OpenRouter (identificação do app)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=SGOA

# --- Avisos automatizados de prazo (worker npm run lembretes) ---
# Intervalo entre verificações em ms (padrão 6h); UMA_VEZ=true roda um ciclo e sai.
LEMBRETES_INTERVALO_MS=21600000
# LEMBRETES_UMA_VEZ=false

# --- E-mail do projeto (SMTP da universidade, conta única) ---
# Todos os envios (avisos de prazo, recuperação de senha) partem desta conta.
# Sem SMTP_HOST ou sem credencial completa → modo stub (só log), sem falhar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Login de autenticação no SMTP (geralmente o próprio e-mail institucional).
SMTP_USER=
# Remetente exibido nos e-mails (conta do projeto, ex: sgoa@utfpr.edu.br).
SMTP_FROM=
# Senha cifrada com SMTP_TOKEN_KEY. Gerar com: node criptografar-smtp.js "sua-senha"
# e colar o valor resultante aqui (ou no .env local, nunca commitado).
SMTP_PASS_ENC=
# 32 bytes em hex (gerar com: openssl rand -hex 32). Trocar invalida SMTP_PASS_ENC.
SMTP_TOKEN_KEY=

# --- Bootstrap do admin e seed (desenvolvimento) ---
# create-admin (node scripts/create-admin.js): cria o admin SOMENTE se não
# houver usuários. Em produção, preferir create-admin ao seed.
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Seed APAGA todas as tabelas e é travado com NODE_ENV=production.
# ALLOW_SEED=1 libera o seed mesmo em produção (emergencial, com backup feito).
# ALLOW_SEED=