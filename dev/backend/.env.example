PORT=3000
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=dev_secret_sgoa_change_me

# Tempo de expiração do token
JWT_EXPIRES_IN=2d

# Caminho do arquivo de banco SQLite (desenvolvimento)
DB_PATH=./data/sgoa.sqlite

# Diretório onde os arquivos enviados serão armazenados
UPLOAD_DIR=./uploads

# Limite máximo de upload em bytes (50MB)
MAX_UPLOAD_SIZE=52428800

# URL base da API (usada pelo frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# --- Integração Google Calendar / Meet (OAuth por professor) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integracoes/google/callback
# 32 bytes em hex (gerar com: openssl rand -hex 32). Usada para criptografar refresh_tokens.
GOOGLE_TOKEN_KEY=
# Domínio Workspace exigido no login Google (ex: instituicao.edu.br). Vazio = aceita qualquer conta.
GOOGLE_WORKSPACE_DOMAIN=
# URL do frontend (para redirecionar o callback OAuth)
FRONTEND_URL=http://localhost:5173